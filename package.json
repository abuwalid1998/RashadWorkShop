{
  "name": "rashad-workshop",
  "productName": "Rashad Workshop",
  "version": "2.0.0",
  "description": "ورشة رشاد — إدارة طلبات الصيانة، الحسابات، المدفوعات وضمان البطاريات. تطبيق سطح مكتب يعمل بدون خادم.",
  "author": "Amjad Khaliliah",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test --no-warnings --test-reporter=spec \"tests/*.test.js\"",
    "migrate": "node scripts/migrate-mysql-to-sqlite.js",
    "seed:demo": "node scripts/run-with-electron.js scripts/seed-demo.js",
    "icons": "electron scripts/make-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.rashadworkshop.desktop",
    "productName": "Rashad Workshop",
    "copyright": "Copyright © 2026 Rashad Workshop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rashad Workshop",
      "artifactName": "RashadWorkshop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RashadWorkshop-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "artifactName": "RashadWorkshop-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Rashad Workshop",
      "artifactName": "RashadWorkshop-${version}-${arch}.${ext}"
    }
  }
}
